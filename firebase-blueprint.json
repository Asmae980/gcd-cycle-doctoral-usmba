{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "Ouvrage du fonds documentaire universitaire",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Titre du livre"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Auteur principal"
        },
        "isbn": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^[0-9Xx\\-]+$",
          "description": "Numéro ISBN"
        },
        "filiere": {
          "type": "string",
          "enum": ["GI", "GE", "GIM", "TM", "RT"],
          "description": "Filière universitaire associée"
        },
        "totalCopies": {
          "type": "integer",
          "description": "Nombre total d'exemplaires"
        },
        "availableCopies": {
          "type": "integer",
          "description": "Nombre d'exemplaires disponibles"
        },
        "qrCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Code QR de l'ouvrage"
        },
        "lastLoanId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Dernier emprunt lié à une variation de stock"
        },
        "coverImage": {
          "type": "string",
          "minLength": 0,
          "maxLength": 350000,
          "description": "Image de couverture redimensionnée (Data URL JPEG/PNG)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Date de dernière mise à jour serveur"
        }
      },
      "required": [
        "title",
        "author",
        "isbn",
        "filiere",
        "totalCopies",
        "availableCopies",
        "qrCode",
        "lastLoanId",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil d'un étudiant ou bibliothécaire authentifié",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifiant Firebase Auth"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Nom complet"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150,
          "description": "Adresse email"
        },
        "role": {
          "type": "string",
          "enum": ["student", "librarian", "manager"],
          "description": "Rôle attribué"
        },
        "cne": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[A-Z0-9]+$",
          "description": "Code National de l'Étudiant"
        },
        "filiere": {
          "type": "string",
          "enum": ["GI", "GE", "GIM", "TM", "RT", "Administration"],
          "description": "Filière de l'utilisateur"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Date de création serveur"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Date de mise à jour serveur"
        }
      },
      "required": [
        "uid",
        "fullName",
        "email",
        "role",
        "cne",
        "filiere",
        "createdAt",
        "updatedAt"
      ]
    },
    "LibrarianRole": {
      "title": "LibrarianRole",
      "description": "Registre de confiance des comptes bibliothécaires",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "ManagerRole": {
      "title": "ManagerRole",
      "description": "Registre de confiance des comptes gérants",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Adherent": {
      "title": "Adherent",
      "description": "Fiche d'adhérent / lecteur gérée par le gérant",
      "type": "object",
      "properties": {
        "cardNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "cne": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[A-Z0-9]+$"
        },
        "apogee": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[0-9]+$"
        },
        "filiere": {
          "type": "string",
          "enum": ["GI", "GE", "GIM", "TM", "RT"]
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "registrationDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "expiryDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["actif", "suspendu"]
        },
        "suspensionReason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "cardNumber",
        "studentUid",
        "fullName",
        "cne",
        "apogee",
        "filiere",
        "email",
        "registrationDate",
        "expiryDate",
        "status",
        "suspensionReason",
        "createdAt",
        "updatedAt"
      ]
    },
    "Loan": {
      "title": "Loan",
      "description": "Emprunt ou réservation d'un ouvrage",
      "type": "object",
      "properties": {
        "ticketCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifiant QR du ticket d'emprunt"
        },
        "bookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bookAuthor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "bookIsbn": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^[0-9Xx\\-]+$"
        },
        "bookFiliere": {
          "type": "string",
          "enum": ["GI", "GE", "GIM", "TM", "RT"]
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "studentCne": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[A-Z0-9]+$"
        },
        "studentFiliere": {
          "type": "string",
          "enum": ["GI", "GE", "GIM", "TM", "RT"]
        },
        "borrowDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dueDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "returnDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["reserve", "en_cours", "rendu"]
        },
        "finalPenalty": {
          "type": "number"
        },
        "reminderCount": {
          "type": "integer"
        },
        "lastReminderDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ticketCode",
        "bookId",
        "bookTitle",
        "bookAuthor",
        "bookIsbn",
        "bookFiliere",
        "studentUid",
        "studentName",
        "studentCne",
        "studentFiliere",
        "borrowDate",
        "dueDate",
        "returnDate",
        "status",
        "finalPenalty",
        "reminderCount",
        "lastReminderDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Journal des actions de la bibliothèque (emprunt, retour, prolongation, relance)",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "actorRole": {
          "type": "string",
          "enum": ["student", "librarian", "manager"]
        },
        "actionType": {
          "type": "string",
          "enum": [
            "emprunt",
            "retour",
            "prolongation",
            "relance",
            "reservation",
            "ajout_livre",
            "modification_livre",
            "inscription_adherent",
            "renouvellement_adherent",
            "suspension_adherent",
            "reactivation_adherent"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "actorUid",
        "actorName",
        "actorRole",
        "actionType",
        "description",
        "targetId",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Catalogue des ouvrages de la bibliothèque"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profils utilisateurs authentifiés (PII protégée)"
    },
    "/librarians/{userId}": {
      "schema": { "$ref": "#/entities/LibrarianRole" },
      "description": "Liste de contrôle d'accès des bibliothécaires"
    },
    "/managers/{userId}": {
      "schema": { "$ref": "#/entities/ManagerRole" },
      "description": "Liste de contrôle d'accès des gérants"
    },
    "/adherents/{adherentId}": {
      "schema": { "$ref": "#/entities/Adherent" },
      "description": "Registre des adhérents et cartes lecteurs"
    },
    "/loans/{loanId}": {
      "schema": { "$ref": "#/entities/Loan" },
      "description": "Emprunts et réservations des étudiants"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Historique immuable des actions"
    }
  }
}
